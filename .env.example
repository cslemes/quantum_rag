# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Fronteira A — frontier generator accessed via API (research.md D10)
ANTHROPIC_API_KEY=
FRONTEIRA_A_MODEL=claude-sonnet-4-5

# Fronteira B — a second frontier generator from a distinct model family,
# used to control for single-provider idiosyncrasy (research.md D10).
# Deliberately provider-agnostic: point this at whichever family you pick.
FRONTEIRA_B_API_KEY=
FRONTEIRA_B_BASE_URL=
FRONTEIRA_B_MODEL=

# Local generator via Ollama (research.md D10, D10b). Ollama runs on the
# HOST, not in docker-compose — host.docker.internal is how the app
# container reaches it (requires extra_hosts: host-gateway, already set on
# the app service in docker-compose.yml). Running natively on the host (not
# in a container) is what gets the benchmarked 100% GPU / 492 tok/s prefill
# (D10) — a containerized Ollama would need GPU passthrough reconfigured and
# would re-download the model into a separate volume. If running qcagent
# directly on the host instead of in the app container (e.g. local dev
# without Docker), change this back to http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=16384

# Qdrant (research.md D5b)
QDRANT_URL=http://localhost:6333

# Agent loop (research.md D8 — MAX_ITER=5 is a pilot hypothesis, not final)
MAX_ITER=5

# Sandbox / WorkerPool (research.md D1b, D11)
SANDBOX_TIMEOUT_S=60
WORKER_POOL_SIZE=6
WORKER_RECYCLE_AFTER=50

# Paths
RESULTS_DIR=results

LOG_LEVEL=INFO
